<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.junaxer.torneo.controller.MainController"
            style="-fx-pref-width: 1100px; -fx-pref-height: 680px; -fx-background-color: #f1f5f9;">

    <left>
        <fx:include fx:id="formulario" source="formulario-view.fxml"/>
    </left>

    <center>
        <VBox style="-fx-background-color: #f8fafc; -fx-padding: 20px; -fx-spacing: 14px;">

            <Label text="Listado de Participantes Inscritos"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

            <TableView fx:id="tablaParticipantes" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="130.0"/>
                    <TableColumn fx:id="colEdad" text="Edad" prefWidth="50.0" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="85.0"/>
                    <TableColumn fx:id="colModalidad" text="Modalidad" prefWidth="85.0"/>
                    <TableColumn fx:id="colDisciplina" text="Disciplina" prefWidth="85.0"/>
                    <TableColumn fx:id="colCaracteristicas" text="Características" prefWidth="160.0"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="75.0" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="90.0" style="-fx-alignment: CENTER;"/>
                </columns>
                <placeholder>
                    <Label text="No hay participantes registrados"/>
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox style="-fx-alignment: center-right;">
                <Label fx:id="lblTotal" text="Total de inscritos: 0"
                       style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
