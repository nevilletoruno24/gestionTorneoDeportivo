<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ToolBar?>

<ToolBar xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="ni.junaxer.torneo.controller.ToolBarController"
         style="-fx-background-color: #FFFFFF; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0; -fx-padding: 6px 16px; -fx-spacing: 8px;">
    <Button text="Nuevo Registro" onAction="#onNuevoRegistro"
            style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-cursor: hand; -fx-padding: 6 12; -fx-background-radius: 4; -fx-border-color: #cbd5e1; -fx-border-radius: 4;"/>
    <Button text="Confirmar Todos" onAction="#onConfirmarTodos"
            style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-cursor: hand; -fx-padding: 6 12; -fx-background-radius: 4; -fx-border-color: #cbd5e1; -fx-border-radius: 4;"/>
    <Button text="Vaciar Tabla" onAction="#onVaciarTabla"
            style="-fx-background-color: #fee2e2; -fx-text-fill: #991b1b; -fx-cursor: hand; -fx-padding: 6 12; -fx-background-radius: 4; -fx-border-color: #fca5a5; -fx-border-radius: 4;"/>
</ToolBar>
