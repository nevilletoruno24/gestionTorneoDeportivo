<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>

<MenuBar xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="ni.junaxer.torneo.controller.MenuBarController"
         style="-fx-background-color: #FFFFFF; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0;">
    <Menu text="Archivo">
        <MenuItem text="Salir" onAction="#onSalir"/>
    </Menu>
    <Menu text="Ayuda">
        <MenuItem text="Acerca de" onAction="#onAcercaDe"/>
    </Menu>
</MenuBar>
